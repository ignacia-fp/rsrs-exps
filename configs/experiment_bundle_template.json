{
  "_README": [
    "Copy this file, edit it, then run: rsrs-experiment build your_file.json",
    "The sampling target is a minimum: compatible cached rows are reused.",
    "Use GMRES mode 1 for an unpreconditioned-only run with no sampling or factorisation.",
    "Dotted sweep keys modify nested values, for example rsrs.tol_ext_near."
  ],
  "_NUMBERED_OPTIONS": {
    "operator": {
      "0": "biegrid_real_symmetric",
      "1": "biegrid_real_nonsymmetric",
      "2": "biegrid_complex_symmetric",
      "3": "biegrid_complex_nonsymmetric",
      "4": "bempp_cl_laplace_single_layer",
      "5": "bempp_cl_helmholtz_combined",
      "6": "bempp_rs_laplace_single_layer",
      "7": "laplace_particle_fmm"
    },
    "symmetry": {"0": "NoSymm", "1": "Symmetric", "2": "Hermitian"},
    "sampling.symmetry": {"0": "auto", "1": "symmetric", "2": "nonsymmetric"},
    "gmres.mode": {"0": "none", "1": "unpreconditioned", "2": "preconditioned", "3": "both"},
    "fixed_rank_sampling_mode": {"0": "PerLevel", "1": "Constant"},
    "nonsymmetric_id_combination": {"0": "Sum", "1": "Concat"},
    "null_method": {"0": "Projection", "1": "Svd", "2": "Qr"},
    "qr_method": {"0": "RRQR", "1": "SRRQR"},
    "block_extraction": {"0": "LuLstSq", "1": "Svd"},
